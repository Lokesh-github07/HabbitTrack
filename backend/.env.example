FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret

MONGODB_URI=mongodb://localhost:27017/habbittrack
MONGODB_DATABASE=habbittrack

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Microsoft OAuth (optional until configured)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
